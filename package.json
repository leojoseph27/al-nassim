{
  "name": "nassim-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:https": "next dev -p 3000 --experimental-https --experimental-https-key ./certs/dev-lan-key.pem --experimental-https-cert ./certs/dev-lan.pem",
    "dev:https:certs": "mkcert -cert-file certs/dev-lan.pem -key-file certs/dev-lan-key.pem 192.168.1.172 localhost 127.0.0.1 ::1",
    "build": "node --require ./scripts/readlink-shim.cjs ./node_modules/next/dist/bin/next build",
    "start": "next start -p 3000",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node prisma/seed.mjs",
    "typecheck": "tsc --noEmit",
    "seed:owner-test-data": "node scripts/seed-owner-test-data.mjs",
    "cleanup:owner-test-data": "node scripts/cleanup-owner-test-data.mjs",
    "build:css": "tailwindcss -i tailwind.src.css -o public/assets/css/tailwind.css",
    "build:css:admin": "tailwindcss -i tailwind.admin.src.css -o public/assets/css/tailwind.admin.css -c tailwind.admin.config.js"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "jsdom": "^24.1.3",
    "jsonwebtoken": "^9.0.2",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "resend": "^6.18.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.21",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0"
  }
}
