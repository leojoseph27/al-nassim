# Copy this file to .env and fill in real values.
# Never commit .env — it is git-ignored.

# PostgreSQL connection string.
# Format: postgresql://<role>:<password>@<host>:<port>/<database>
# Sprint 0 (SEC-02) recommends a dedicated least-privilege role + database
# (e.g. postgresql://nassim_app:<password>@localhost:5432/nassim).
DATABASE_URL="postgresql://nassim_app:CHANGE_ME@localhost:5432/nassim"

# Secret used to sign session JWTs (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 bytes (64 hex chars). Rotate on any suspected leak.
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_HEX_STRING"

# Name of the httpOnly cookie that carries the session JWT.
SESSION_COOKIE_NAME="nassim_sid"

# Seeded administrator account. The seed script (prisma/seed.mjs) creates
# this user on first run with role ADMIN. The password is hashed with bcrypt
# (cost 10) and stored in the User table; it is never re-hashed on re-seed
# if the user already exists.
ADMIN_SEED_EMAIL="admin@alnassim.com"
ADMIN_SEED_PASSWORD="CHANGE_ME_TO_A_STRONG_PASSWORD"

# Seeded SUPERADMIN / OWNER account (optional but recommended). The seed
# script creates this user on first run with role SUPERADMIN (owner of the
# Superadmin dashboard). Like the ADMIN seed, the password is bcrypt-hashed
# (cost 12) and NEVER overwritten on re-seed once the user exists.
SUPERADMIN_SEED_EMAIL="owner@alnassim.com"
SUPERADMIN_SEED_PASSWORD="CHANGE_ME_TO_A_STRONG_OWNER_PASSWORD"

# Email (Resend) — for password reset emails
# Get your API key from https://resend.com/onboarding
RESEND_API_KEY="re_YOUR_API_KEY"
APP_URL="http://localhost:3000"
EMAIL_FROM="AL-NASSIM <onboarding@resend.dev>"

# Public origin used for customer-facing order links (WhatsApp messages).
# MUST be the reachable production origin — never a LAN or preview URL.
# Example: https://al-nassim.vercel.app
APP_BASE_URL=""

# Seeded staff account (role STAFF). Created on first seed run; the password
# is bcrypt-hashed and never overwritten once the user exists.
STAFF_SEED_EMAIL="staff@alnassim.com"
STAFF_SEED_PASSWORD="CHANGE_ME_TO_A_STRONG_STAFF_PASSWORD"

# Dedicated Store Staff account for the internal Order Page (see scripts/create-store-orders-staff.mjs)
STORE_ORDERS_STAFF_EMAIL="store.orders@alnassim.com"
STORE_ORDERS_STAFF_PASSWORD="CHANGE_ME_TO_A_STRONG_TEMPORARY_PASSWORD"

# Web Push (VAPID) for staff new-order notifications on /internal-orders.html.
# SERVER-SIDE ONLY — never expose the private key to the browser.
# Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The subject is a contact mailto: included in push handshakes.
VAPID_PUBLIC_KEY="CHANGE_ME_BASE64URL_PUBLIC_KEY"
VAPID_PRIVATE_KEY="CHANGE_ME_BASE64URL_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@example.com"

# ===== WhatsApp automation (Baileys local service) =====
WHATSAPP_SERVICE_URL=http://127.0.0.1:4000
WHATSAPP_API_KEY=
# STRICT TESTING PHASE: automated messages may ONLY go to these numbers
# (comma-separated). Any other number is redirected to the FIRST one.
WHATSAPP_TEST_RECIPIENT=96566235398,919567767488
