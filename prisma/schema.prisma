generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PurchaseMode {
  ONLINE
  INQUIRY
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  SEEN
  UNDER_REVIEW
  READY_FOR_CONFIRMATION
  CONFIRMED
  PACKING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_STAFF
}

enum OrderItemStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  REMOVED_AFTER_CONFIRMATION
  DELIVERED
}

enum PosStatus {
  NOT_CREATED
  INVOICED
  HANDED_TO_DELIVERY
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
  DISCONTINUED
}

// Product-information area a dynamic custom attribute renders in.
// HEADER = main info column (name/price/SKU area)
// DESCRIPTION = product description accordion
// SPECIFICATIONS = specs grid
enum AttributeSection {
  HEADER
  DESCRIPTION
  SPECIFICATIONS
}

// Supported dynamic field types (first version: TEXT, LONG_TEXT, NUMBER, SELECT).
enum AttributeType {
  TEXT
  LONG_TEXT
  NUMBER
  SELECT
}

model Department {
  id           Int          @id @default(autoincrement())
  slug         String       @unique
  name         String
  purchaseMode PurchaseMode @default(ONLINE)
  categories   Category[]
  sections     Section[]
}

model Section {
  id           Int        @id @default(autoincrement())
  slug         String     @unique
  name         String
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id])
  categories   Category[]

  @@index([departmentId])
}

model Category {
  id            Int           @id @default(autoincrement())
  slug          String        @unique
  name          String
  departmentId  Int
  department    Department    @relation(fields: [departmentId], references: [id])
  sectionId     Int?
  section       Section?      @relation(fields: [sectionId], references: [id])
  subcategories Subcategory[]
  products      Product[]

  @@index([sectionId])
}

model Subcategory {
  id               Int               @id @default(autoincrement())
  slug             String            @unique
  name             String
  categoryId       Int
  category         Category          @relation(fields: [categoryId], references: [id])
  products         Product[]
  customAttributes CustomAttribute[]

  @@index([categoryId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Material {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Color {
  id       Int            @id @default(autoincrement())
  slug     String         @unique
  name     String
  hex      String         @default("")
  products ProductColor[]
}

model Size {
  id       Int           @id @default(autoincrement())
  slug     String        @unique
  name     String
  products ProductSize[]
}

model Supplier {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  contact  String    @default("")
  phone    String    @default("")
  email    String    @default("")
  products Product[]
}

model Unit {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Country {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Tax {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  rate     Decimal   @db.Decimal(6, 3) @default(0)
  products Product[]
}

model ProductColor {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   Int
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)

  @@id([productId, colorId])
}

model ProductSize {
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId    Int
  size      Size    @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@id([productId, sizeId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  @@index([productId])
}

// Dynamic custom attribute DEFINITION — belongs to one classification:
// either a Subcategory (primary; exactly what products are filed under) or,
// as a fallback for categories that have no subcategories, the Category
// itself (categoryId, natural id, NO foreign key — the Category table is
// owned by the postgres migration role and cannot take one from the app
// role). Exactly ONE of subcategoryId / categoryId is set (enforced by the
// API layer). Created once by the admin; every product under that
// classification then gets an input for it. Soft-deleted via isDeleted so
// historical ProductCustomValue rows survive (values are keyed by
// attributeId, so renaming never detaches them).
model CustomAttribute {
  id            Int             @id @default(autoincrement())
  name          String
  section       AttributeSection @default(SPECIFICATIONS)
  fieldType     AttributeType    @default(TEXT)
  subcategoryId Int?
  subcategory   Subcategory?     @relation(fields: [subcategoryId], references: [id])
  /// Category-level fallback scope (set when subcategoryId is null).
  categoryId    Int?
  displayOrder  Int             @default(0)
  options       String[]        @default([])
  isDeleted     Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  values        ProductCustomValue[]

  @@index([subcategoryId])
  @@index([categoryId])
}

/* ------------------------------------------------------------------ */
/* Dynamic-spec i18n side tables (2026-08-19)                          */
/*                                                                     */
/* The legacy PIM tables above are owned by the postgres migration     */
/* role and cannot be ALTERed by the least-privilege app role, so      */
/* English/Arabic metadata lives in these companion tables keyed by    */
/* natural ids (NO foreign keys — same pattern as OrderSecurity).      */
/* English remains in the original columns (existing data untouched);  */
/* Arabic is additive and falls back to English when empty.            */
/* ------------------------------------------------------------------ */

/// Arabic name + extended-type config for a CustomAttribute (1:1).
/// `multiSelect` only applies to SELECT attributes — the product form then
/// renders multi-checkbox input and stores the chosen options comma-joined.
model AttributeI18n {
  attributeId Int     @id
  nameAr      String  @default("")
  multiSelect Boolean @default(false)
}

/// Arabic label for one dropdown option (EN option text is the match key —
/// it is the value stored in CustomAttribute.options and ProductCustomValue).
model AttributeOptionI18n {
  id          Int    @id @default(autoincrement())
  attributeId Int
  optionEn    String
  optionAr    String @default("")

  @@unique([attributeId, optionEn])
  @@index([attributeId])
}

/// Arabic value for a product's custom-field entry, keyed by the natural
/// (productId, attributeId) pair so it survives EN-row rewrites.
model ProductCustomValueI18n {
  productId   Int
  attributeId Int
  valueAr     String @default("")

  @@id([productId, attributeId])
  @@index([attributeId])
}

/// Arabic name for a Color (EN name stays in Color.name).
model ColorI18n {
  colorId Int    @id
  nameAr  String @default("")
}

/// Arabic name for a Material (EN name stays in Material.name).
model MaterialI18n {
  materialId Int    @id
  nameAr     String @default("")
}

// Per-PRODUCT value for a custom attribute. The definition lives on
// CustomAttribute; only the value lives here. Empty string = field left blank.
model ProductCustomValue {
  id          Int             @id @default(autoincrement())
  productId   Int
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   CustomAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String          @default("")

  @@unique([productId, attributeId])
  @@index([attributeId])
}

// Admin-selected related products (ordered, one-directional).
// productId = the product being viewed; relatedId = the product shown in its
// "Related Products" section. Storefront falls back to same-section products
// when a product has no rows here.
model RelatedProduct {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  relatedId    Int
  related      Product  @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)
  displayOrder Int      @default(0)

  @@unique([productId, relatedId])
  @@index([relatedId])
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  note      String   @default("")
  actorId   Int?
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Address {
  id        Int     @id @default(autoincrement())
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String  @default("Home")
  fullName  String  @default("")
  phone     String  @default("")
  address   String
  city      String
  area      String  @default("")
  isDefault Boolean @default(false)

  @@index([userId])
}

model Product {
  id             Int         @id @default(autoincrement())
  slug           String      @unique
  name           String
  /// Arabic display name (additive, like classCode/depth). Empty = not yet
  /// entered — the storefront falls back to the English `name`. The stored
  /// string is NEVER reordered; RTL rendering is purely a display concern.
  nameAr         String      @default("")
  description    String      @default("")
  longDescription String     @default("")
  price          Decimal     @db.Decimal(10, 3)
  discount       Decimal     @db.Decimal(10, 3) @default(0)
  costPrice      Decimal     @db.Decimal(10, 3) @default(0)
  currency       String      @default("KD")
  image          String      @default("")
  images         String[]    @default([])
  line           String      @default("")
  sku            String      @default("")
  barcode        String      @default("")
  ndNumber       String      @default("")
  internalCode   String      @default("")
  /// Internal grouping code (e.g. ZC-13, KN-100). Products sharing a class
  /// form a variant/related group for future storefront grouping. STRICTLY
  /// INTERNAL: never exposed in public catalog/detail responses. Empty =
  /// the product is independent (no linked variants).
  classCode      String      @default("")
  specs          Json        @default("[]")
  applications   String      @default("")
  additionalInfo String      @default("")
  seoTitle       String      @default("")
  seoDescription String      @default("")
  tags           String[]    @default([])
  weight         Decimal?    @db.Decimal(10, 3)
  length         Decimal?    @db.Decimal(10, 3)
  width          Decimal?    @db.Decimal(10, 3)
  height         Decimal?    @db.Decimal(10, 3)
  depth          Decimal?    @db.Decimal(10, 3)
  /// Unit shared by length/width/height/depth (mm | cm | m). Existing rows
  /// default to "cm" — the unit the original admin labels always used.
  dimensionUnit  String      @default("cm")
  warranty       String      @default("")
  stock          Int         @default(100)
  minStock       Int         @default(10)
  stockStatus    StockStatus @default(IN_STOCK)
  isActive       Boolean     @default(true)
  isFeatured     Boolean     @default(false)
  isNewArrival   Boolean     @default(false)
  isBestSeller   Boolean     @default(false)
  categoryId     Int
  category       Category    @relation(fields: [categoryId], references: [id])
  subcategoryId  Int?
  subcategory    Subcategory? @relation(fields: [subcategoryId], references: [id])
  brandId        Int?
  brand          Brand?      @relation(fields: [brandId], references: [id])
  materialId     Int?
  material       Material?   @relation(fields: [materialId], references: [id])
  supplierId     Int?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  unitId         Int?
  unit           Unit?       @relation(fields: [unitId], references: [id])
  countryId      Int?
  country        Country?    @relation(fields: [countryId], references: [id])
  taxId          Int?
  tax            Tax?        @relation(fields: [taxId], references: [id])
  colors         ProductColor[]
  sizes          ProductSize[]
  mediaImages    ProductImage[]
  customValues   ProductCustomValue[]
  relatedFrom    RelatedProduct[] @relation("RelatedFrom")
  relatedTo      RelatedProduct[] @relation("RelatedTo")
  stockMovements StockMovement[]
  orderItems  OrderItem[]
  wishlist    WishlistItem[]
  cartItems   CartItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([brandId])
  @@index([supplierId])
  @@index([barcode])
}

model User {
  id              Int                   @id @default(autoincrement())
  email           String                @unique
  name            String
  phone           String                @default("")
  passwordHash    String
  role            UserRole              @default(CUSTOMER)
  designation     String                @default("")
  isActive        Boolean               @default(true)
  sessions        Session[]
  orders          Order[]
  addresses       Address[]
  wishlist        WishlistItem[]
  cartItems       CartItem[]
  passwordTokens  PasswordResetToken[]
  createdAt       DateTime              @default(now())
  updatedAt    DateTime   @updatedAt
}

model Session {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model CartItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  userId        Int?
  user          User?       @relation(fields: [userId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String
  address       String
  city          String
  notes         String      @default("")
  status        OrderStatus @default(PENDING)
  staffNotes    String      @default("")
  posStatus     PosStatus   @default(NOT_CREATED)
  // WhatsApp send-state: set when staff sends the WhatsApp message for this
  // order. Separate from the order status state machine.
  whatsappSent  Boolean     @default(false)
  // WhatsApp notification lifecycle shared by the automatic (post-checkout)
  // and manual (staff) send paths:
  //   PENDING  not yet attempted (fresh order, or automation was OFF)
  //   SENDING  an attempt is in progress (atomic claim; stale attempts expire)
  //   SENT     Baileys confirmed delivery (whatsappSent also true)
  //   FAILED   last attempt failed; whatsappError carries the reason and
  //            staff can retry from the staff page
  whatsappStatus String     @default("PENDING")
  whatsappAuto   Boolean    @default(false)
  whatsappSentAt DateTime?
  whatsappError  String?
  subtotal      Decimal     @db.Decimal(10, 3)
  shipping      Decimal     @db.Decimal(10, 3) @default(2.5)
  total         Decimal     @db.Decimal(10, 3)
  currency      String      @default("KD")
  // Permanent ownership snapshot — captured at checkout, never mutated by
  // account deletion. `originalUserId` is the stable ownership identifier
  // (the account that placed the order); `originalUserEmail` is the historical
  // customer email for admin/legal records. The live `userId`/`customerEmail`
  // may be nulled/tombstoned when the account is deleted, but these persist so
  // the order stays identifiable and the snapshot is never lost.
  originalUserId    Int?     @map("original_user_id")
  originalUserEmail String   @default("") @map("original_user_email")
  items         OrderItem[]
  statusHistory OrderStatusEvent[]
  notifications Notification[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([customerEmail])
  @@index([originalUserId])
  @@index([originalUserEmail])
  @@index([createdAt])
}

model OrderItem {
  id         Int             @id @default(autoincrement())
  orderId    Int
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int?
  product    Product?        @relation(fields: [productId], references: [id])
  slug       String
  name       String
  image      String          @default("")
  price      Decimal         @db.Decimal(10, 3)
  quantity   Int
  itemStatus OrderItemStatus @default(PENDING)

  @@index([orderId])
  @@index([productId])
}

/// Security metadata for an order (1:1 via the globally-unique orderNumber —
/// no FK, because the legacy Order table is owned by the postgres migration
/// role and the app's least-privilege role cannot create constraints on it).
///   tokenHash      SHA-256 of the raw guest-tracking capability token — the
///                  raw value is returned once at checkout and never stored.
///                  Guests must present it to view/confirm the order; the
///                  sequential order id/number alone grants nothing.
///   idempotencyKey Client-generated per submission attempt; a replay with the
///                  same key returns the original order instead of creating
///                  (and stock-reserving) a duplicate.
model OrderSecurity {
  orderNumber    String  @id
  tokenHash      String  @unique
  idempotencyKey String? @unique
}

model OrderStatusEvent {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String      @default("")
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Setting {
  key   String @id
  value String
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int?
  action    String
  entity    String
  entityId  String   @default("")
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([entity])
  @@index([createdAt])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  orderId   Int?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  message   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([orderId])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
